name: Deploy to cPanel (Theme & Plugins)

on:
  push:
    branches: [main, master]

# Không cho 2 lần deploy chạy chồng nhau (FTP ghi đè lẫn nhau + manifest giám sát file lệch).
concurrency:
  group: deploy-production
  cancel-in-progress: false

env:
  # Repository variable SITE_URL (Settings → Secrets and variables → Actions → Variables).
  SITE_URL: ${{ vars.SITE_URL || 'https://clients.lacadev.com' }}
  # Thiếu secret nào thì bước tương ứng tự bỏ qua — không làm hỏng deploy.
  DISCORD_DEPLOY_WEBHOOK: ${{ secrets.DISCORD_DEPLOY_WEBHOOK }}
  LACA_DEPLOY_KEY: ${{ secrets.LACA_DEPLOY_KEY }}

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0 # cần lịch sử để liệt kê file thay đổi so với lần push trước

      - name: Liệt kê file thay đổi
        id: changes
        env:
          BEFORE: ${{ github.event.before }}
        run: |
          if [ -z "$BEFORE" ] || [ "$BEFORE" = "0000000000000000000000000000000000000000" ] || ! git cat-file -e "${BEFORE}^{commit}" 2>/dev/null; then
            BEFORE="$(git rev-parse HEAD~1 2>/dev/null || git hash-object -t tree /dev/null)"
          fi
          git diff --name-status --no-renames "$BEFORE" HEAD > "$RUNNER_TEMP/changes.txt"
          echo "count=$(wc -l < "$RUNNER_TEMP/changes.txt" | tr -d ' ')" >> "$GITHUB_OUTPUT"

      # Chặn deploy nếu có file PHP lỗi cú pháp — 1 lỗi gõ nhầm là đủ làm sập cả site
      # (hosting đang chạy PHP 8.3).
      - name: Setup PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: '8.3'
          coverage: none

      - name: Kiểm tra cú pháp PHP
        id: phplint
        run: |
          # php -l in "No syntax errors detected" khi ổn; còn lại (Parse error / Errors parsing) là lỗi.
          find app/public/wp-content/themes -name '*.php' -not -path '*/node_modules/*' -not -path '*/vendor/*' -print0 \
            | xargs -0 -n1 -P4 sh -c 'php -d display_errors=stdout -d log_errors=0 -l "$0" || true' 2>&1 \
            | grep -vE '^No syntax errors detected|^$' \
            | sed 's#app/public/##g' > "$RUNNER_TEMP/php-lint.txt" || true
          if [ -s "$RUNNER_TEMP/php-lint.txt" ]; then
            cat "$RUNNER_TEMP/php-lint.txt"
            exit 1
          fi

      # -------------------------------------------------------------
      # KIỂM TRA DRIFT TRƯỚC KHI DEPLOY:
      # Chặn deploy đè lên thay đổi trên server mà chưa được kéo về git
      # -------------------------------------------------------------
      - name: Kiểm tra drift production trước khi deploy
        id: check-drift
        env:
          SSH_KEY: ${{ secrets.PROD_SSH_KEY }}
          SSH_HOST: ${{ secrets.PROD_SSH_HOST }}
          SSH_PORT: ${{ secrets.PROD_SSH_PORT || '22' }}
          SSH_USER: ${{ secrets.PROD_SSH_USER }}
          SSH_KNOWN_HOSTS: ${{ secrets.PROD_SSH_KNOWN_HOSTS }}
          PROD_PATH: ${{ vars.PROD_PATH || '/home/user/public_html' }}
          DEPLOY_DRIFT_MODE: ${{ vars.DEPLOY_DRIFT_MODE || 'block' }} # block | warn | off
          DISCORD_WEBHOOK: ${{ secrets.DISCORD_DEPLOY_WEBHOOK }}
        run: |
          if [ "$DEPLOY_DRIFT_MODE" = "off" ]; then
            echo "⚡ Bỏ qua kiểm tra drift (DEPLOY_DRIFT_MODE=off)."
            exit 0
          fi

          if [ -z "$SSH_KEY" ] || [ -z "$SSH_HOST" ] || [ -z "$SSH_USER" ]; then
            echo "⚠️ Thiếu cấu hình SSH (PROD_SSH_*), bỏ qua kiểm tra drift."
            exit 0
          fi

          mkdir -p ~/.ssh && chmod 700 ~/.ssh
          echo "$SSH_KEY" > ~/.ssh/id_rsa && chmod 600 ~/.ssh/id_rsa
          if [ -n "$SSH_KNOWN_HOSTS" ]; then
            echo "$SSH_KNOWN_HOSTS" >> ~/.ssh/known_hosts
          else
            # Không tự tin host lạ (MITM). Thiếu secret → bỏ qua bước kiểm drift, không chặn deploy.
            echo "::warning::Thiếu secret PROD_SSH_KNOWN_HOSTS — bỏ qua kiểm tra file lệch trên production."
            exit 0
          fi

          BEFORE="${{ github.event.before }}"
          if [ -z "$BEFORE" ] || [ "$BEFORE" = "0000000000000000000000000000000000000000" ]; then
            BEFORE="HEAD~1"
          fi

          mkdir -p "$RUNNER_TEMP/prev-checkout"
          git archive "$BEFORE" app/public/wp-content/themes app/public/wp-content/plugins | tar -x -C "$RUNNER_TEMP/prev-checkout" 2>/dev/null || true

          rsync -rlcn --itemize-changes -c -e "ssh -p $SSH_PORT" \
            --exclude='node_modules' --exclude='.git' --exclude='*.log' --exclude='cache' \
            --exclude='wflogs' --exclude='upgrade' --exclude='uploads' \
            "$SSH_USER@$SSH_HOST:$PROD_PATH/wp-content/themes/" "$RUNNER_TEMP/prev-checkout/app/public/wp-content/themes/" > "$RUNNER_TEMP/drift-themes.txt" 2>&1 || true

          rsync -rlcn --itemize-changes -c -e "ssh -p $SSH_PORT" \
            --exclude='node_modules' --exclude='.git' --exclude='*.log' --exclude='cache' \
            --exclude='wflogs' --exclude='upgrade' --exclude='uploads' \
            "$SSH_USER@$SSH_HOST:$PROD_PATH/wp-content/plugins/" "$RUNNER_TEMP/prev-checkout/app/public/wp-content/plugins/" > "$RUNNER_TEMP/drift-plugins.txt" 2>&1 || true

          DRIFT_COUNT=$(grep -vE '^\.d' "$RUNNER_TEMP/drift-themes.txt" "$RUNNER_TEMP/drift-plugins.txt" 2>/dev/null | grep -E '^>' | wc -l | tr -d ' ')

          if [ "$DRIFT_COUNT" -gt 0 ]; then
            MSG="🛑 PHÁT HIỆN $DRIFT_COUNT TẬP TIN BỊ LỆCH TRÊN PRODUCTION CHƯA KÉO VỀ GIT!"
            echo "$MSG"
            if [ "$DEPLOY_DRIFT_MODE" = "block" ]; then
              if [ -n "$DISCORD_WEBHOOK" ]; then
                curl -s -H "Content-Type: application/json" -d "{\"content\":\"$MSG Vui lòng chạy workflow 'Kéo thay đổi từ production' để merge trước khi deploy.\"}" "$DISCORD_WEBHOOK" || true
              fi
              echo "Deploy bị dừng để bảo vệ server khỏi bị ghi đè phiên bản cũ."
              exit 1
            else
              echo "⚠️ Cảnh báo: $MSG (DEPLOY_DRIFT_MODE=$DEPLOY_DRIFT_MODE)."
            fi
          else
            echo "✅ Không phát hiện drift trên production."
          fi

      - name: Báo site bắt đầu deploy
        if: env.LACA_DEPLOY_KEY != ''
        continue-on-error: true
        run: |
          jq -n --arg run "${{ github.run_id }}" --arg sha "${{ github.sha }}" '{phase: "start", run_id: $run, commit: $sha}' > "$RUNNER_TEMP/start.json"
          bash .github/scripts/laca-deploy-notify.sh "$RUNNER_TEMP/start.json"

      - name: Use Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20.x

      - name: Create config.json from dist
        working-directory: app/public/wp-content/themes/lacadev-client-child
        run: cp config.json.dist config.json

      - name: Install Node dependencies
        working-directory: app/public/wp-content/themes/lacadev-client-child
        run: yarn install --frozen-lockfile

      - name: Build theme assets (dist/ — CSS/JS/fonts/images)
        working-directory: app/public/wp-content/themes/lacadev-client-child
        run: yarn build:theme

      - name: Build Gutenberg blocks (block-gutenberg/**/build)
        working-directory: app/public/wp-content/themes/lacadev-client-child
        run: yarn build:blocks

      - name: Deploy Theme & Plugins
        id: ftp
        uses: SamKirkland/FTP-Deploy-Action@v4.3.4
        with:
          server: ${{ secrets.FTP_SERVER }}
          username: ${{ secrets.FTP_USERNAME }}
          password: ${{ secrets.FTP_PASSWORD }}
          server-dir: /clients.lacadev.com/
          local-dir: app/public/
          include: |
            wp-content/themes/**
            wp-content/plugins/**
          exclude: |
            .git/
            .github/
            *.md
            .cpanel.yml
            .gitignore
            wp-content/themes/**/node_modules/**
            wp-content/themes/**/doc/**
            wp-content/themes/**/theme-server/**
            wp-content/themes/**/build-release.sh
            wp-content/themes/**/composer.json
            wp-content/themes/**/composer.lock
            wp-content/themes/**/package.json
            wp-content/themes/**/yarn.lock
            wp-content/themes/**/config.json
            wp-content/themes/**/config.json.dist
            wp-content/themes/**/postcss.config.js
            wp-content/themes/**/tailwind.config.js
            wp-content/themes/**/.eslintrc.js
            wp-content/themes/**/.stylelintrc.json
            wp-content/themes/**/.editorconfig
            wp-content/themes/**/.gitignore
            wp-content/themes/**/.DS_Store
            wp-content/themes/**/*.scss
            wp-content/plugins/**/node_modules/**
            wp-content/plugins/**/.DS_Store
            wp-content/uploads/**
            wp-admin/**
            wp-includes/**
            wp-content/upgrade/**
            wp-content/cache/**
            wp-content/languages/**
            wp-content/wflogs/**
            wp-content/litespeed/**
            wp-content/upgrade-temp-backup/**
            wp-content/backup-db/**
            wp-content/debug.log
            .htaccess
            license.txt
            local-xdebuginfo.php
            local-phpinfo.php
            readme.html
            wp-activate.php
            wp-blog-header.php
            wp-comments-post.php
            wp-config-sample.php
            wp-config.php
            wp-cron.php
            wp-links-opml.php
            wp-load.php
            wp-mail.php
            wp-settings.php
            wp-signup.php
            wp-trackback.php
            wp-login.php
            xmlrpc.php
            index.php

      - name: Báo site danh sách file đã deploy
        id: manifest
        if: success() && env.LACA_DEPLOY_KEY != ''
        continue-on-error: true
        env:
          COMMIT_MSG: ${{ github.event.head_commit.message }}
          AUTHOR: ${{ github.event.head_commit.author.name || github.actor }}
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
        run: |
          cd app/public
          find wp-content/themes wp-content/plugins -type f -not -path '*/node_modules/*' -not -name '*.md' \
            -not -path '*/doc/*' -not -path '*/theme-server/*' -not -name 'build-release.sh' \
            -not -name 'postcss.config.js' -not -name 'tailwind.config.js' -not -name '.eslintrc.js' \
            \( -name '*.php' -o -name '*.phtml' -o -name '*.phar' -o -name '*.pht' -o -name '*.php[3-8]' \
               -o -name '*.inc' -o -name '*.js' -o -name '*.ini' -o -name '*.sh' -o -name '*.py' -o -name '*.pl' \
               -o -name '*.cgi' -o -name '.htaccess' -o -name '.user.ini' \) -print0 \
            | xargs -0 sha256sum \
            | jq -R -n '[inputs | capture("^(?<h>[0-9a-f]{64}) [ *](?<p>.+)$") | {(.p): .h}] | add // {}' > "$RUNNER_TEMP/files.json"
          roots="$(find wp-content/themes wp-content/plugins -mindepth 1 -maxdepth 1 -type d | jq -R -s 'split("\n") | map(select(length > 0))')"
          jq -n \
            --slurpfile files "$RUNNER_TEMP/files.json" \
            --argjson roots "$roots" \
            --arg run "${{ github.run_id }}" --arg sha "${{ github.sha }}" \
            --arg author "$AUTHOR" --arg msg "$COMMIT_MSG" --arg url "$RUN_URL" \
            '{phase: "finish", run_id: $run, commit: $sha, author: $author, message: $msg, run_url: $url, roots: $roots, files: $files[0]}' \
            > "$RUNNER_TEMP/finish.json"
          echo "Manifest: $(jq '.files | length' "$RUNNER_TEMP/finish.json") file"
          bash "$GITHUB_WORKSPACE/.github/scripts/laca-deploy-notify.sh" "$RUNNER_TEMP/finish.json" | tee "$RUNNER_TEMP/finish-response.json"

      - name: Kiểm tra site sau deploy
        id: health
        if: success()
        run: |
          : > "$RUNNER_TEMP/health.txt"
          bad=0
          for path in "/" "/wp-json/wp/v2/types" "/wp-login.php"; do
            code=$(curl -s -o /dev/null -w "%{http_code}" -m 15 "$SITE_URL$path" || echo "000")
            echo "$code $path" >> "$RUNNER_TEMP/health.txt"
            if [ "$code" -ge 500 ] || [ "$code" = "000" ]; then
              bad=$((bad + 1))
            fi
          done
          cat "$RUNNER_TEMP/health.txt"
          if [ "$bad" -gt 0 ]; then
            echo "Phát hiện $bad endpoint lỗi"
            exit 1
          fi

